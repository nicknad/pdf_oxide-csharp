<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>FfiCrashHost</AssemblyName>
    <RootNamespace>FfiCrashHost</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Run as `dotnet FfiCrashHost.dll` so tests can invoke it the same way on every OS. -->
    <UseAppHost>false</UseAppHost>
    <IsPackable>false</IsPackable>
    <!-- This is a test tool; keep the repository-wide analyzer policy out of its way. -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <RunAnalyzers>false</RunAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfOxideBindings\PdfOxideBindings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The native asset must sit next to the host assembly at runtime. -->
    <Content Include="..\..\runtimes\**\*">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
