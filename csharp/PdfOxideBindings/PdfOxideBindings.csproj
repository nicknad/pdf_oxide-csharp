<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>1.0.2</Version>
    <PackageId>PdfOxide.Bindings</PackageId>
    <Description>Cross-platform .NET bindings for PDF Oxide.</Description>
    <PackageTags>pdf;pdf-generation;pdf-oxide</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
    <!-- We want to allow unsafe code as required by the generated bindings -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- This is a library that will be consumed -->
    <OutputType>Library</OutputType>
    <!-- Suppress CA2255 (ModuleInitializer in library) and CA5392 (DllImport search paths) -->
    <NoWarn>$(NoWarn);CA2255;CA5392</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Include the generated bindings -->
    <Compile Include="../../dotnet/PdfOxideBindings.cs" Link="PdfOxideBindings.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The crash host and tests call raw native entry points on purpose. -->
    <InternalsVisibleTo Include="FfiCrashHost" />
    <InternalsVisibleTo Include="PdfOxideTests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Default font used by the HTML+CSS pipeline (DejaVu Sans, permissive licence). -->
    <EmbeddedResource Include="Fonts/DejaVuSans.ttf" LogicalName="PdfOxide.Fonts.DejaVuSans.ttf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />

    <!--
      Ship each native binary as a RID-specific NuGet native asset and copy it
      next to project-reference builds. These stay a single None item: NuGet
      merges duplicate None/Content items, and a Content item with Pack="false"
      silently drops the native assets from the package.
    -->
    <None Include="../../runtimes/**/*"
          Pack="true"
          PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)"
          Link="%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
